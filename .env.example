# Google Apps Script bridge (Sales Data tab) — see SETUP.md §1.
# Not the Sheets API directly: this org's Cloud policy blocks
# service-account keys, and a personal OAuth flow needs periodic
# re-authorization until verified, so a script bound to the sheet itself
# (running permanently as whoever deployed it) stands in for both.
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# ZeptoMail — reuse the same values already configured for the kpi project
ZEPTOMAIL_URL=
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_SENDER=

# Comma-separated recipient(s) for the daily follow-up digest
FOLLOWUP_DIGEST_TO=
FOLLOWUP_DIGEST_CC=
FOLLOWUP_DIGEST_BCC=
