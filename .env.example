# Google OAuth client (Sheets API) — see SETUP.md §1. Not a service-account
# key: this org's Cloud policy blocks those, so auth is a one-time OAuth
# consent (visit /api/google-authorize) that yields a refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# The "OD - Sales Ashish" spreadsheet
SALES_SHEET_ID=1qnb4o7rl47po5wf2GQN8B_gsxifkq1LEm3AMNd45lKw
SALES_SHEET_TAB=Sales Data

# ZeptoMail — reuse the same values already configured for the kpi project
ZEPTOMAIL_URL=
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_SENDER=

# Comma-separated recipient(s) for the daily follow-up digest
FOLLOWUP_DIGEST_TO=
