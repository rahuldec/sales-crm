# Master Control registry bridge (Tenants tab) — see SETUP.md §1. Every
# manager's own sheet bridge URL/token lives IN that sheet, not here — this
# is the one bridge the app needs an env var for, since it's how the app
# finds all the others.
REGISTRY_URL=
REGISTRY_TOKEN=

# ZeptoMail — reuse the same values already configured for the kpi project
ZEPTOMAIL_URL=
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_SENDER=

# Local dev only — never set in Vercel. Lets api routes resolve identity as
# this email without a real Zoho login, so the multi-tenant logic (registry
# lookup, tenant isolation, master aggregation) can be exercised locally.
# Only honored for requests that actually arrive on localhost — see
# lib/zoho.js. Set it to any Login Email from your Tenants registry row.
DEV_BYPASS_EMAIL=
