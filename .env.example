# OD-MASTER's own Apps Script bridge (serves its "Credentials" tab for
# login, and each manager's mirrored tab for the Master rollup view) — see
# SETUP.md §1. Every manager's OWN sheet bridge URL/token lives IN the
# Credentials tab, not here — this is the one bridge the app needs an env
# var for, since it's how the app finds all the others.
MASTER_URL=
MASTER_TOKEN=

# ZeptoMail — reuse the same values already configured for the kpi project
ZEPTOMAIL_URL=
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_SENDER=
